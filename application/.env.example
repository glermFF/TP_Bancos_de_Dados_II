# Compose (dev e produção) — copie para .env neste diretório e preencha.
NEO4J_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
# Porta onde o app fica exposto. Escolha uma livre — no Umbrel, 8080/8081 costumam estar em uso.
APP_PORT=8480
# Interface da exposição: 127.0.0.1 = só a própria máquina (padrão);
# IP da LAN da máquina (ex.: 192.168.1.10) = acessível na rede local. Internet: só pelo túnel.
APP_BIND=127.0.0.1
# Domínio público servido pelo túnel (trava o CORS)
PUBLIC_ORIGIN=https://cachaceiro.seu-dominio.com
# Senha dos viajantes de exemplo do seed (vazio = aleatória, impressa no log)
SEED_USER_PASSWORD=
# Token do túnel (Cloudflare Zero Trust → Tunnels)
TUNNEL_TOKEN=
