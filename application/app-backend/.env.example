# Cachaceiro Viajante API — copie para .env e preencha
PORT=3000
HOST=127.0.0.1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# Senha dos viajantes de exemplo criados pelo seed (vazio = aleatória, impressa no log)
SEED_USER_PASSWORD=
# Produção: origens permitidas no CORS (separadas por vírgula) e build web exportado
# ALLOWED_ORIGINS=https://seu-dominio.exemplo.com
# WEB_DIST=/app/web
