{
  "name": "app-backend",
  "version": "1.0.0",
  "description": "Cachaceiro Viajante API — Express + Neo4j backend (auth, distilleries, reviews, route solver)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "seed": "ts-node --transpile-only src/scripts/seed.ts --force",
    "seed:auto": "ts-node --transpile-only src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["neo4j", "express", "cachaca", "route-planner"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
